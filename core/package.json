{
  "name": "starnet-polaris-core",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && npm run build:engine",
    "build:engine": "esbuild src/engine/global.ts --bundle --format=iife --target=es2015 --outfile=dist-engine/engine.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/saira": "5.3.0",
    "@radix-ui/colors": "^3.0.0",
    "lucide-react": "^1.48.0",
    "motion": "^13.4.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "overrides": {
    "framer-motion": "13.4.4",
    "motion-dom": "13.4.4",
    "motion-utils": "13.3.0"
  }
}
